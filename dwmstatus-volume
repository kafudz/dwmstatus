#!/usr/bin/env python3
"""dwmstatus-volume - volume slider popup for dwm's status bar.

Run without arguments to show a small slider under the pointer; bind it to a
left click on the volume segment in dwm's config.h (see README).  The helper
commands --get, --set, --mute, --unmute and --toggle-mute are handy for
testing and for other key bindings.

Backends: wpctl (PipeWire) is preferred, pactl (PulseAudio) is the fallback.
The slider itself needs GTK 3 and PyGObject; the command line modes do not.
"""

import fcntl
import os
import re
import shutil
import signal
import subprocess
import sys

SINK = "@DEFAULT_AUDIO_SINK@"
PULSE_SINK = "@DEFAULT_SINK@"
DEVNULL = subprocess.DEVNULL


def detect_backend():
    if shutil.which("wpctl"):
        return "wpctl"
    if shutil.which("pactl"):
        return "pactl"
    return None


def run(args):
    try:
        result = subprocess.run(args, stdout=subprocess.PIPE, stderr=DEVNULL,
                                text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return ""
    return result.stdout


def get_state(backend):
    """Return (percent, muted), or None when the backend cannot be queried."""
    if backend == "wpctl":
        out = run(["wpctl", "get-volume", SINK])
        match = re.search(r"Volume:\s*([0-9.]+)", out)
        if not match:
            return None
        return (round(float(match.group(1)) * 100), "[MUTED]" in out)

    out = run(["pactl", "get-sink-volume", PULSE_SINK])
    match = re.search(r"(\d+)%", out)
    if not match:
        return None
    muted = "yes" in run(["pactl", "get-sink-mute", PULSE_SINK]).lower()
    return (int(match.group(1)), muted)


def set_volume(backend, percent):
    percent = max(0, min(100, int(percent)))
    if backend == "wpctl":
        args = ["wpctl", "set-volume", SINK, f"{percent}%"]
    else:
        args = ["pactl", "set-sink-volume", PULSE_SINK, f"{percent}%"]
    subprocess.run(args, stdout=DEVNULL, stderr=DEVNULL, check=False)


def set_mute(backend, muted):
    if backend == "wpctl":
        args = ["wpctl", "set-mute", SINK, "1" if muted else "0"]
    else:
        args = ["pactl", "set-sink-mute", PULSE_SINK, "1" if muted else "0"]
    subprocess.run(args, stdout=DEVNULL, stderr=DEVNULL, check=False)


def popup_lock():
    """Claim the single-instance lock.

    Returns an open file descriptor that holds the lock, or None when another
    popup is already open.  A second click on the volume segment closes the
    open popup instead of stacking a new one.
    """
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    path = os.path.join(runtime, f"dwmstatus-volume-{os.getuid()}.lock")
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        try:
            os.lseek(fd, 0, os.SEEK_SET)
            pid = int(os.read(fd, 32).decode().strip())
            if pid > 1:
                os.kill(pid, signal.SIGTERM)
        except (OSError, ValueError):
            pass
        os.close(fd)
        return None
    os.ftruncate(fd, 0)
    os.write(fd, str(os.getpid()).encode())
    return fd


def popup(backend):
    lock = popup_lock()
    if lock is None:
        return 0

    try:
        import gi
        gi.require_version("Gdk", "3.0")
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gdk, GLib, Gtk
    except (ImportError, ValueError) as error:
        print(f"dwmstatus-volume: GTK 3 / PyGObject unavailable: {error}",
              file=sys.stderr)
        return 1

    state = get_state(backend)
    if state is None:
        print("dwmstatus-volume: cannot read the current volume", file=sys.stderr)
        return 1
    volume, muted = state

    GLib.set_prgname("dwmstatus-volume")
    Gdk.set_program_class("dwmstatus-volume")

    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_title("Volume")
    win.set_decorated(False)
    win.set_resizable(False)
    win.set_border_width(12)
    win.set_skip_taskbar_hint(True)
    win.set_skip_pager_hint(True)
    win.set_keep_above(True)
    win.set_type_hint(Gdk.WindowTypeHint.DIALOG)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)

    header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
    title = Gtk.Label(label="Volume", xalign=0)
    value = Gtk.Label(label=f"{volume}%", xalign=1)
    header.pack_start(title, True, True, 0)
    header.pack_end(value, False, False, 0)

    scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
    scale.set_draw_value(False)
    scale.set_value(volume)
    scale.set_size_request(240, -1)

    mute = Gtk.Button(label="Unmute" if muted else "Mute")

    box.pack_start(header, False, False, 0)
    box.pack_start(scale, False, False, 0)
    box.pack_start(mute, False, False, 0)
    win.add(box)

    muted_now = [muted]
    pending = [0]
    shown_at = [0]

    def apply_volume():
        pending[0] = 0
        level = int(round(scale.get_value()))
        if muted_now[0]:
            set_mute(backend, False)
            muted_now[0] = False
            mute.set_label("Mute")
        set_volume(backend, level)
        value.set_text(f"{level}%")
        return False

    def on_value_changed(widget):
        value.set_text(f"{int(round(widget.get_value()))}%")
        if pending[0]:
            GLib.source_remove(pending[0])
        # Coalesce drag events: one wpctl/pactl call per pause, not per pixel.
        pending[0] = GLib.timeout_add(60, apply_volume)

    def on_mute_clicked(button):
        muted_now[0] = not muted_now[0]
        set_mute(backend, muted_now[0])
        button.set_label("Unmute" if muted_now[0] else "Mute")

    def on_key_press(widget, event):
        if event.keyval in (Gdk.KEY_Escape, Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            win.destroy()
            return True
        return False

    def on_focus_out(widget, event):
        # Ignore the focus transition caused by mapping the popup itself.
        if GLib.get_monotonic_time() - shown_at[0] > 200000:
            win.destroy()
        return False

    scale.connect("value-changed", on_value_changed)
    mute.connect("clicked", on_mute_clicked)
    win.connect("key-press-event", on_key_press)
    win.connect("focus-out-event", on_focus_out)
    win.connect("destroy", Gtk.main_quit)

    win.show_all()
    win.present()

    # Place the popup under the click, on the monitor that owns the pointer.
    display = Gdk.Display.get_default()
    seat = display.get_default_seat()
    pointer = seat.get_pointer()
    _, px, py = pointer.get_position()
    monitor = display.get_monitor_at_point(px, py) or display.get_primary_monitor()
    if monitor is not None:
        geometry = monitor.get_geometry()
        width, height = win.get_size()
        x = min(max(px - width // 2, geometry.x + 8),
                geometry.x + geometry.width - width - 8)
        y = py + 24
        if y + height > geometry.y + geometry.height - 8:
            y = geometry.y + geometry.height - height - 8
        win.move(x, y)

    shown_at[0] = GLib.get_monotonic_time()
    Gtk.main()
    return 0


def usage(stream=sys.stderr):
    print("usage: dwmstatus-volume [--get | --set PERCENT | --mute | "
          "--unmute | --toggle-mute]", file=stream)
    return 2


def main():
    backend = detect_backend()
    if backend is None:
        print("dwmstatus-volume: neither wpctl nor pactl is installed",
              file=sys.stderr)
        return 1

    argv = sys.argv[1:]
    if not argv:
        return popup(backend)

    command = argv[0]
    if command in ("-h", "--help"):
        usage(sys.stdout)
        return 0
    if command in ("-g", "--get"):
        state = get_state(backend)
        if state is None:
            print("dwmstatus-volume: cannot read the current volume",
                  file=sys.stderr)
            return 1
        print("muted" if state[1] else state[0])
        return 0
    if command in ("-s", "--set"):
        if len(argv) != 2 or not argv[1].lstrip("+-").isdigit():
            return usage()
        set_volume(backend, argv[1])
        return 0
    if command == "--mute":
        set_mute(backend, True)
        return 0
    if command == "--unmute":
        set_mute(backend, False)
        return 0
    if command == "--toggle-mute":
        state = get_state(backend)
        if state is None:
            return 1
        set_mute(backend, not state[1])
        return 0

    return usage()


if __name__ == "__main__":
    sys.exit(main())
