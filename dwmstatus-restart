#!/bin/sh
# Restart dwmstatus (e.g. after rebuilding it).

# dwmstatus talks to X, so it needs a display
: "${DISPLAY:=:0}"
export DISPLAY

if ! command -v dwmstatus >/dev/null 2>&1; then
	printf "dwmstatus: not found in PATH\n" >&2
	exit 1
fi

# Stop the old instance and wait (max ~2s) until it is really gone
if pkill -x dwmstatus 2>/dev/null; then
	printf "Killing old dwmstatus ... "
	i=0
	while pgrep -x dwmstatus >/dev/null 2>&1 && [ "$i" -lt 20 ]; do
		sleep 0.1
		i=$((i + 1))
	done
	# Last resort if the old instance ignored SIGTERM
	if pgrep -x dwmstatus >/dev/null 2>&1; then
		pkill -KILL -x dwmstatus 2>/dev/null
		sleep 0.1
	fi
	printf "done.\n"
fi

# Start the new one, detached from this shell
nohup dwmstatus </dev/null >/dev/null 2>&1 &
