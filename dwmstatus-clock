#!/usr/bin/env python3
"""dwmstatus-clock - the clock and calendar popup for the dwmstatus panel.

A left click on the clock segment opens this window.  It shows the live time
and date, followed by a month calendar with its own previous/next navigation.

The popup is horizontally centred: under the clock segment when the panel
anchors it, otherwise in the middle of the monitor, 40 px from the top.
"""

import datetime
import json
import os
import sys
import threading
import time
import urllib.parse
import urllib.request

sys.dont_write_bytecode = True  # keep __pycache__ out of the repo

_os_tz = os.environ.get("DWMSTATUS_TZ") or "Asia/Jakarta"
if _os_tz:
    os.environ["TZ"] = _os_tz
    time.tzset()

# The bar clock is centred, so its popup is centred as well.
os.environ.setdefault("DWMSTATUS_PANEL_ALIGN", "center")

HERE = os.path.dirname(os.path.realpath(__file__))
for _path in (HERE, os.path.join(HERE, os.pardir, "lib", "dwmstatus")):
    if os.path.isfile(os.path.join(_path, "dwmstatus_gtk.py")):
        sys.path.insert(0, _path)
        break

try:
    import dwmstatus_gtk as ui
except ImportError:
    sys.exit("dwmstatus-clock: dwmstatus_gtk.py not found "
             "(run 'make install' from the dwmstatus repo)")

ICON_CLOCK = "\uf017"     # nf-fa-clock_o
ICON_CALENDAR = "\uf073"  # nf-fa-calendar

# Visible gaps between an icon and its label, in pixels.
CLOCK_ICON_GAP = 28       # clock icon -> live time and date
ICON_TEXT_GAP = 12        # calendar icon -> "Calendar" heading

# Weather comes from Open-Meteo (no API key).  It is fetched in a background
# thread and cached, so an offline machine never blocks or breaks the popup.
WEATHER_API = "https://api.open-meteo.com/v1/forecast"
WEATHER_TTL = 600         # seconds between refreshes
WEATHER_TIMEOUT = 5       # seconds before giving up on a request
WEATHER_CACHE = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or "/tmp",
    f"dwmstatus-weather-{os.getuid()}.json")

# WMO weather code -> Nerd Font glyph and a short description.
WEATHER_CODES = {
    0: ("\uf185", "Clear"),
    1: ("\uf6c4", "Mostly clear"),
    2: ("\uf6c4", "Partly cloudy"),
    3: ("\uf0c2", "Cloudy"),
    45: ("\uf0c2", "Fog"),
    48: ("\uf0c2", "Rime fog"),
    51: ("\uf043", "Light drizzle"),
    53: ("\uf043", "Drizzle"),
    55: ("\uf043", "Heavy drizzle"),
    56: ("\uf043", "Freezing drizzle"),
    57: ("\uf043", "Freezing drizzle"),
    61: ("\uf043", "Light rain"),
    63: ("\uf043", "Rain"),
    65: ("\uf043", "Heavy rain"),
    66: ("\uf043", "Freezing rain"),
    67: ("\uf043", "Freezing rain"),
    71: ("\uf2dc", "Light snow"),
    73: ("\uf2dc", "Snow"),
    75: ("\uf2dc", "Heavy snow"),
    77: ("\uf2dc", "Snow grains"),
    80: ("\uf043", "Rain showers"),
    81: ("\uf043", "Rain showers"),
    82: ("\uf043", "Violent showers"),
    85: ("\uf2dc", "Snow showers"),
    86: ("\uf2dc", "Snow showers"),
    95: ("\uf0e7", "Thunderstorm"),
    96: ("\uf0e7", "Thunderstorm"),
    99: ("\uf0e7", "Thunderstorm"),
}


def weather_settings():
    """Location, time zone and temperature unit for the weather request."""
    try:
        lat = float(os.environ.get("DWMSTATUS_LAT", "-6.2088"))
        lon = float(os.environ.get("DWMSTATUS_LON", "106.8456"))
    except ValueError:
        lat, lon = -6.2088, 106.8456
    unit = os.environ.get("DWMSTATUS_WEATHER_UNIT", "C").upper()
    if unit not in ("C", "F"):
        unit = "C"
    return lat, lon, unit


def weather_url():
    lat, lon, unit = weather_settings()
    params = {
        "latitude": f"{lat:.4f}",
        "longitude": f"{lon:.4f}",
        "current": "temperature_2m,weather_code",
        "timezone": os.environ.get("DWMSTATUS_TZ") or "Asia/Jakarta",
        "temperature_2m_unit": "fahrenheit" if unit == "F" else "celsius",
    }
    return WEATHER_API + "?" + urllib.parse.urlencode(params)


def format_weather(data):
    """Turn an Open-Meteo response into (glyph, label)."""
    current = data.get("current") or {}
    temp = current.get("temperature_2m")
    code = current.get("weather_code")
    if temp is None or code is None:
        raise ValueError("incomplete weather response")
    glyph, description = WEATHER_CODES.get(
        int(code), ("\uf0c2", "Weather"))
    _, _, unit = weather_settings()
    return glyph, f"{temp:.0f}°{unit}  {description}"


def read_weather_cache():
    """Fresh cached result, or None."""
    try:
        if time.time() - os.path.getmtime(WEATHER_CACHE) > WEATHER_TTL:
            return None
        with open(WEATHER_CACHE, encoding="utf-8") as handle:
            cached = json.load(handle)
        return (cached["glyph"], cached["text"])
    except (OSError, ValueError, KeyError, TypeError):
        return None


def write_weather_cache(result):
    glyph, text = result
    tmp = f"{WEATHER_CACHE}.{os.getpid()}"
    try:
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump({"glyph": glyph, "text": text}, handle)
        os.replace(tmp, WEATHER_CACHE)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def fetch_weather():
    """Cached weather, or a fallback glyph/label; never raises."""
    cached = read_weather_cache()
    if cached is not None:
        return cached
    try:
        with urllib.request.urlopen(weather_url(), timeout=WEATHER_TIMEOUT) as reply:
            result = format_weather(json.load(reply))
        write_weather_cache(result)
        return result
    except Exception:
        # A stale value is still more useful than an empty popup.
        try:
            with open(WEATHER_CACHE, encoding="utf-8") as handle:
                cached = json.load(handle)
            return cached["glyph"], cached["text"]
        except (OSError, ValueError, KeyError, TypeError):
            return "\uf0c2", "Weather unavailable"


def popup():
    if ui.claim_lock("clock") is None:
        return 0

    try:
        import gi
        gi.require_version("Gdk", "3.0")
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gdk, GLib, Gtk
    except (ImportError, ValueError) as error:
        print(f"dwmstatus-clock: GTK 3 / PyGObject unavailable: {error}",
              file=sys.stderr)
        return 1

    ui.install_css(Gtk, Gdk)
    win = ui.make_window(Gtk, Gdk, GLib)

    content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)

    # --- clock ------------------------------------------------------------
    clock_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                        spacing=CLOCK_ICON_GAP)
    clock_box.set_border_width(6)

    glyph = Gtk.Label(label=ICON_CLOCK)
    glyph.get_style_context().add_class("dwmstatus-icon")
    glyph.set_valign(Gtk.Align.CENTER)

    # The text box fills the row; right-aligning its labels keeps the icon
    # on the left and the live time/date on the right edge of the popup.
    text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    time_label = Gtk.Label(xalign=1)
    time_label.get_style_context().add_class("dwmstatus-clock")
    date_label = Gtk.Label(xalign=1)
    date_label.get_style_context().add_class("dwmstatus-small")
    text_box.pack_start(time_label, False, False, 0)
    text_box.pack_start(date_label, False, False, 0)

    clock_box.pack_start(glyph, False, False, 0)
    clock_box.pack_start(text_box, True, True, 0)
    content.pack_start(clock_box, False, False, 0)
    content.pack_start(Gtk.Separator(), False, False, 0)

    # --- weather ----------------------------------------------------------
    weather_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                          spacing=ICON_TEXT_GAP)
    weather_box.set_border_width(6)
    weather_glyph = Gtk.Label(label="\uf0c2")
    weather_glyph.get_style_context().add_class("dwmstatus-icon")
    weather_glyph.set_valign(Gtk.Align.CENTER)
    weather_label = Gtk.Label(label="Loading weather…", xalign=0)
    weather_label.get_style_context().add_class("dwmstatus-weather")
    weather_box.pack_start(weather_glyph, False, False, 0)
    weather_box.pack_start(weather_label, True, True, 0)
    content.pack_start(weather_box, False, False, 0)
    content.pack_start(Gtk.Separator(), False, False, 0)

    def show_weather(result):
        glyph, text = result
        weather_glyph.set_label(glyph)
        weather_label.set_text(text)
        return False  # GLib.idle_add: run once

    def weather_worker():
        GLib.idle_add(show_weather, fetch_weather())

    def refresh_weather():
        threading.Thread(target=weather_worker, daemon=True).start()
        return True  # keep the periodic timeout alive

    refresh_weather()
    GLib.timeout_add_seconds(WEATHER_TTL, refresh_weather)

    def tick_clock():
        now = datetime.datetime.now()
        time_label.set_text(f"{now:%H:%M}")
        date_label.set_text(f"{now:%A, %d %B %Y}")
        return True

    tick_clock()
    GLib.timeout_add_seconds(1, tick_clock)

    # --- calendar ---------------------------------------------------------
    today = datetime.date.today()

    def date_text(day):
        return f"{day:%a, %d %b %Y}"

    cal_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    cal_box.set_border_width(6)
    cal_value = Gtk.Label(label=date_text(today), xalign=1)
    calendar = Gtk.Calendar()
    calendar.set_display_options(Gtk.CalendarDisplayOptions.SHOW_DAY_NAMES)
    calendar.select_month(today.month - 1, today.year)
    calendar.select_day(today.day)

    # Own month header instead of GtkCalendar's built-in one, so the < and >
    # buttons can have breathing room around them.
    nav = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
    nav.set_border_width(2)
    month_label = Gtk.Label(xalign=0.5)
    month_label.get_style_context().add_class("dwmstatus-title")
    month_label.get_style_context().add_class("dwmstatus-month")
    prev_month = Gtk.Button(label="<")
    next_month = Gtk.Button(label=">")
    for button in (prev_month, next_month):
        button.get_style_context().add_class("dwmstatus-nav")
    nav.pack_start(prev_month, False, False, 0)
    nav.pack_start(month_label, True, True, 0)
    nav.pack_end(next_month, False, False, 0)

    def update_month_label():
        year, month, _ = calendar.get_date()
        month_label.set_text(
            datetime.date(year, month + 1, 1).strftime("%B %Y"))
        on_day_selected(calendar)

    def shift_month(delta):
        year, month, _ = calendar.get_date()
        month += delta
        year += month // 12
        month %= 12
        calendar.select_month(month, year)
        update_month_label()

    def on_day_selected(widget):
        year, month, day = widget.get_date()
        cal_value.set_text(date_text(datetime.date(year, month + 1, day)))

    prev_month.connect("clicked", lambda _button: shift_month(-1))
    next_month.connect("clicked", lambda _button: shift_month(1))
    calendar.connect("month-changed", lambda _calendar: update_month_label())
    calendar.connect("day-selected", on_day_selected)
    update_month_label()

    heading = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,
                      spacing=ICON_TEXT_GAP)
    cal_glyph = Gtk.Label(label=ICON_CALENDAR)
    cal_glyph.get_style_context().add_class("dwmstatus-icon")
    cal_glyph.set_valign(Gtk.Align.CENTER)
    name = Gtk.Label(label="Calendar", xalign=0)
    name.get_style_context().add_class("dwmstatus-title")
    heading.pack_start(cal_glyph, False, False, 0)
    heading.pack_start(name, True, True, 0)
    heading.pack_end(cal_value, False, False, 0)

    cal_box.pack_start(heading, False, False, 0)
    cal_box.pack_start(nav, False, False, 0)
    cal_box.pack_start(calendar, False, False, 0)
    content.pack_start(cal_box, False, False, 0)

    display = Gdk.Display.get_default()
    geometry, place = ui.placement(display)
    ui.present(win, content, geometry, place, Gtk, Gdk, GLib)

    # Give the calendar the focus so the arrow keys work immediately.
    calendar.grab_focus()
    Gtk.main()
    return 0


def usage(stream=sys.stderr):
    print("usage: dwmstatus-clock", file=stream)
    return 2


def main():
    argv = sys.argv[1:]
    if not argv:
        return popup()
    if argv[0] in ("-h", "--help"):
        usage(sys.stdout)
        return 0
    return usage()


if __name__ == "__main__":
    sys.exit(main())
