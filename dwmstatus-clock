#!/usr/bin/env python3
"""dwmstatus-clock - a small clock popup for the dwmstatus panel.

A left click on the clock segment opens this window.  It only shows the time
and the date; the calendar has its own popup, dwmstatus-calendar (a right
click on the clock segment).

When the panel starts the popup it sets DWMSTATUS_PANEL="x,y,w,h"; the popup
then opens right below the panel (above it for a bottom bar), aligned to its
right edge.  Without it the popup appears 40 px from the top and 15 px from
the right edge of the monitor.
"""

import datetime
import os
import sys
import time

sys.dont_write_bytecode = True  # keep __pycache__ out of the repo

_os_tz = os.environ.get("DWMSTATUS_TZ") or "Asia/Jakarta"
if _os_tz:
    os.environ["TZ"] = _os_tz
    time.tzset()

HERE = os.path.dirname(os.path.realpath(__file__))
for _path in (HERE, os.path.join(HERE, os.pardir, "lib", "dwmstatus")):
    if os.path.isfile(os.path.join(_path, "dwmstatus_gtk.py")):
        sys.path.insert(0, _path)
        break

try:
    import dwmstatus_gtk as ui
except ImportError:
    sys.exit("dwmstatus-clock: dwmstatus_gtk.py not found "
             "(run 'make install' from the dwmstatus repo)")

ICON_CLOCK = "\uf017"  # nf-fa-clock_o


def popup():
    if ui.claim_lock("clock") is None:
        return 0

    try:
        import gi
        gi.require_version("Gdk", "3.0")
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gdk, GLib, Gtk
    except (ImportError, ValueError) as error:
        print(f"dwmstatus-clock: GTK 3 / PyGObject unavailable: {error}",
              file=sys.stderr)
        return 1

    ui.install_css(Gtk, Gdk)
    win = ui.make_window(Gtk, Gdk, GLib)

    content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    clock_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
    clock_box.set_border_width(6)

    glyph = Gtk.Label(label=ICON_CLOCK)
    glyph.get_style_context().add_class("dwmstatus-icon")
    glyph.set_valign(Gtk.Align.CENTER)

    text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    time_label = Gtk.Label(xalign=0)
    time_label.get_style_context().add_class("dwmstatus-clock")
    date_label = Gtk.Label(xalign=0)
    date_label.get_style_context().add_class("dwmstatus-small")
    text_box.pack_start(time_label, False, False, 0)
    text_box.pack_start(date_label, False, False, 0)

    clock_box.pack_start(glyph, False, False, 0)
    clock_box.pack_start(text_box, True, True, 0)
    content.pack_start(clock_box, False, False, 0)

    def tick_clock():
        now = datetime.datetime.now()
        time_label.set_text(f"{now:%H:%M}")
        date_label.set_text(f"{now:%A, %d %B %Y}")
        return True

    tick_clock()
    GLib.timeout_add_seconds(1, tick_clock)

    display = Gdk.Display.get_default()
    geometry, place = ui.placement(display)
    ui.present(win, content, geometry, place, Gtk, Gdk, GLib)
    Gtk.main()
    return 0


def usage(stream=sys.stderr):
    print("usage: dwmstatus-clock", file=stream)
    return 2


def main():
    argv = sys.argv[1:]
    if not argv:
        return popup()
    if argv[0] in ("-h", "--help"):
        usage(sys.stdout)
        return 0
    return usage()


if __name__ == "__main__":
    sys.exit(main())
