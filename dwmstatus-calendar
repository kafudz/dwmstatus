#!/bin/sh
# dwmstatus-calendar - compatibility alias.
# The clock popup now includes the calendar, so both names open the same
# combined window.  Existing dwmstatus-calendar bindings keep working.
dir=$(dirname "$0")
if [ -x "$dir/dwmstatus-clock" ]; then
	exec "$dir/dwmstatus-clock"
fi
exec dwmstatus-clock
